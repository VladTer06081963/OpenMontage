{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      },
      "openmontage": {
        "type": "local",
        "command": [
          "/Users/mac/openMontag/.venv/bin/python",
          "/Users/mac/openMontag/scripts/openmontage_mcp.py"
        ],
        "environment": {
          "PYTHONPATH": "/Users/mac/openMontag"
        },
        "disabled": false,
        "codemode": false
      }
    }
  }
}
